# ============================================================
# Mandi Automation Assistant — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in YOUR values.
#   cp .env.example .env
#
# All variables are optional — the app works with safe defaults.
# If a variable is omitted, a placeholder value is used.
#
# Credentials stored in the database are encrypted at rest
# (Fernet encryption). You can also change them later from the
# Settings UI in the app.

# ------------------------------------------------------------
# e-Mandi trader portal credentials
# (replace YOUR_TRADER_ID / YOUR_TRADER_PASSWORD / YOUR_PIN)
# ------------------------------------------------------------
MANDI_E_MANDI_USERNAME=YOUR_TRADER_ID
MANDI_E_MANDI_PASSWORD=YOUR_TRADER_PASSWORD
MANDI_E_MANDI_PIN=0000

# Portal base URL (usually not changed)
MANDI_E_MANDI_URL=https://eanugya.mp.gov.in/Trader.aspx

# ------------------------------------------------------------
# Demo admin user (admin / MANDI_ADMIN_PASSWORD)
# Change this before deploying to a shared server!
# ------------------------------------------------------------
MANDI_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# Application defaults
# ------------------------------------------------------------
MANDI_HAMMALI_RATE=12.05
MANDI_CASH_THRESHOLD=200000
MANDI_AUTOMATION_TIMEOUT=60
MANDI_AUTO_CLOSE_BROWSER=true

# ------------------------------------------------------------
# Security (GENERATE NEW VALUES!)
# SECRET_KEY: any long random string, e.g. from `openssl rand -hex 32`
# ENCRYPTION_KEY: auto-generated to backend/encryption.key on first boot.
#   If you want to manage it yourself, set it here as a hex string.
# ------------------------------------------------------------
# MANDI_SECRET_KEY=change-me-to-a-long-random-string
# MANDI_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
# MANDI_API_HOST=0.0.0.0
# MANDI_API_PORT=8000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite (default):
# MANDI_DATABASE_URL=sqlite+aiosqlite:///./mandi.db
#
# PostgreSQL (optional):
# MANDI_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mandi
